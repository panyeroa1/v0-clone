# Auth Secret - Generate a random string for production
# Generate with: openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
AUTH_SECRET=your-auth-secret-here

# Database URL - PostgreSQL connection string
# Local development: postgresql://user:password@localhost:5432/v0_clone
# Vercel Postgres: Use the connection string from your Vercel dashboard
# Neon: Use the connection string from your Neon dashboard
POSTGRES_URL=postgresql://user:password@localhost:5432/v0_clone

# v0 API Key - Get yours at https://v0.dev/chat/settings/keys
V0_API_KEY=your_v0_api_key_here

# Optional: Use a custom API URL
# V0_API_URL=http://localhost:3001/v1

# Optional: Node environment (development, test, production)
# NODE_ENV=development

# Optional: Public app URL (used for callbacks, webhooks, etc.)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
